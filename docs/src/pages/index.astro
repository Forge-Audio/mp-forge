---
// The website's home: what MP Forge is, how to get it, and what it looks like.

import { Image } from 'astro:assets';

import LaunchVideo from '../components/LaunchVideo.astro';
import Website from '../layouts/Website.astro';
import { LAUNCH_VIDEO } from '../launch-video.js';
import { places } from '../website-places.js';

import logo from '../assets/logo.png';
import wholeApp from '../assets/screenshots/the-mpc-screen.png';
import describing from '../assets/screenshots/describe-a-plugin.png';
import playing from '../assets/screenshots/play-an-instrument.png';
import editing from '../assets/screenshots/edit-the-look.png';
import checking from '../assets/screenshots/run-the-safety-check.png';
import sending from '../assets/screenshots/send-to-your-mpc.png';

const WIDTHS_OFFERED = [640, 960, 1280, 1920];
const WIDTH_ON_THE_FIRST_SCREEN = '(min-width: 56rem) 44rem, 94vw';
const WIDTH_BESIDE_WORDS = '(min-width: 56rem) 38rem, 94vw';
const WHOLE_APP_SHOWS =
	'MP Forge with a finished plugin open: the conversation on the left, and on the right the plugin’s MPC screen with its knobs and faders, the play, send and edit buttons above it, and the sixteen hardware knobs beside it. The status reads SAFE TO SEND.';

// What a visitor should know before downloading. Every post about MP Forge says the same things.
const facts = [
	{ what: 'Free', words: 'Free and open source. There is nothing to buy.', more: places.licence },
	{ what: 'Independent', words: 'Not affiliated with Akai or inMusic.', more: places.status },
	{ what: 'Your own AI', words: 'An account you already have, or a free model on your own computer.', more: places.choosingAnAi },
	{ what: 'MPC OS 3.10.1', words: 'Your MPC needs MPC OS 3.10.1 or later.', more: places.whatYouNeed },
];

const steps = [
	{
		title: 'Start anywhere',
		words: 'Say what you want, as you would to a friend, with a picture or a sound file if it helps. Or press REMIX A PLUGIN to build your own version of one from the Open MPC catalog, or I’M FEELING LUCKY to be surprised. An AI of your choice writes the plugin.',
		picture: describing,
		shows: 'The form for a new plugin, filled in: the name Dusty Tape, the maker Forge Audio, Effect chosen, and a description beside the BUILD IT button.',
		more: { words: 'Making your first plugin', place: places.firstPlugin },
	},
	{
		title: 'See it and play it',
		words: 'The plugin’s screen is shown as it will look on your MPC, and the real plugin plays through your computer’s speakers straight away. An instrument gets a piano to play. An effect gets a beat, or a sound of your own, with ON and OFF to compare.',
		picture: playing,
		shows: 'An instrument being played: its MPC screen, a piano under it, and the sixteen hardware knobs beside it.',
		more: { words: 'Playing and changing a plugin', place: places.firstPlugin },
	},
	{
		title: 'Make it yours',
		words: 'Ask for a change in plain words and hear it. Open EDIT THE LOOK to move, resize and restyle every control and to add your own artwork. Every change keeps the version before it, so going back is always possible.',
		picture: editing,
		shows: 'The editor EDIT THE LOOK: a row of tools, the plugin’s page with its controls to arrange, and on the right the layers, the chosen item and a box for asking MP Forge to change something.',
		more: { words: 'Editing the look by hand', place: places.editingTheLook },
	},
	{
		title: 'Twelve safety checks',
		words: 'A plugin runs inside the MPC’s own app. So MP Forge reads its code, builds it with Akai’s tools and plays it through Akai’s simulator first. A plugin that does not pass cannot be sent.',
		picture: checking,
		shows: 'The status in the top bar reading NOT CHECKED YET, with its menu open and the button RUN THE SAFETY CHECK NOW.',
		more: { words: 'What the checks look for', place: places.safetyChecks },
	},
	{
		title: 'Send it to your MPC',
		words: 'Once it is safe to send, the plugin goes over your network to a USB drive or SD card in your MPC. It never goes onto the MPC’s built-in storage, so pulling the drive out always takes it away again.',
		picture: sending,
		shows: 'The sheet SEND TO YOUR MPC, asking for the MPC’s address, with the buttons CANCEL and SEND.',
		more: { words: 'Setting your MPC up', place: places.sendToYourMpc },
	},
];

// Where a visitor can go next. Donating is offered once there is somewhere for a donation to go.
const waysToJoinIn = [
	{ what: 'Talk to us', words: 'Get help when you are stuck, show the plugins you have made, and ask for what MP Forge is missing.', button: 'Join the Discord', place: places.discord },
	{ what: 'Keep it going', words: 'MP Forge is free and stays free. If it is useful to you, a donation helps to keep it going.', button: 'Donate on Ko-fi', place: places.donations, withACup: true },
	{ what: 'Read the code', words: 'Every line is open. Report a problem, suggest a change, or build MP Forge yourself.', button: 'Go to GitHub', place: places.source },
].filter((way) => way.place);

const needs = [
	{ what: 'A computer', words: 'MP Forge is made for macOS, Windows and Linux.' },
	{ what: 'An AI of your own', words: 'An account with an AI service, or Ollama for models that run on your own computer with no account.' },
	{ what: 'An MPC', words: 'Running MPC OS 3.10.1 or later, with External Plugin Support switched on, and a USB drive or SD card in it.' },
];
---

<Website title="MP Forge: make plugins for your MPC creatively" description="MP Forge is a free, open-source app that makes instruments and effects for Akai MPC hardware from a description.">
	<section class="first-screen">
		<div class="first-words">
			<Image class="logo" src={logo} alt="" width={72} height={72} />
			<h1>Make plugins for your MPC creatively.</h1>
			<p class="lead">
				Start from your own idea, remix an open plugin, or press I’M FEELING LUCKY. Play the real plugin on your
				computer straight away, shape its sound and its screen until it is yours, then send it to your MPC. There is
				no code to write and no build tools to install.
			</p>
			<p class="choices">
				<a class="button large" href={places.download}>Download</a>
				<a class="button quiet" href={places.docs}>Read the docs</a>
			</p>
			<p class="note">For macOS, Windows and Linux.</p>
		</div>

		{
			LAUNCH_VIDEO ? (
				<LaunchVideo video={LAUNCH_VIDEO} poster={wholeApp} posterShows={WHOLE_APP_SHOWS} />
			) : (
				<Image class="picture" src={wholeApp} alt={WHOLE_APP_SHOWS} widths={WIDTHS_OFFERED} sizes={WIDTH_ON_THE_FIRST_SCREEN} loading="eager" />
			)
		}

		<ul class="facts" aria-label="Before you download">
			{
				facts.map((fact) => (
					<li class="fact">
						<a class="fact-name" href={fact.more}>{fact.what}</a>
						<span>{fact.words}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="steps" aria-label="How it works">
		{
			steps.map((step, index) => (
				<article class="step">
					<div class="step-words">
						<p class="label">Step {index + 1}</p>
						<h2>{step.title}</h2>
						<p>{step.words}</p>
						<p>
							<a href={step.more.place}>{step.more.words}</a>
						</p>
					</div>
					<Image class="picture" src={step.picture} alt={step.shows} widths={WIDTHS_OFFERED} sizes={WIDTH_BESIDE_WORDS} />
				</article>
			))
		}
	</section>

	<section class="needs">
		<h2>What you need</h2>
		<ul class="cards">
			{
				needs.map((need) => (
					<li class="card">
						<h3 class="titlebar">{need.what}</h3>
						<p>{need.words}</p>
					</li>
				))
			}
		</ul>
		<p>
			MP Forge tells you if anything else is missing on your computer, and how to get it.{' '}
			<a href={places.whatYouNeed}>What you need</a> has the full list.
		</p>
	</section>

	<section class="joining">
		<h2>Join in</h2>
		<ul class="cards">
			{
				waysToJoinIn.map((way) => (
					<li class="card">
						<h3 class="titlebar">{way.what}</h3>
						<p>{way.words}</p>
						<p class="choices">
							<a class="button quiet" href={way.place}>
								{way.withACup && <img src={places.koFiCup} alt="" width="32" height="22" />}
								{way.button}
							</a>
						</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="closing">
		<h2>Free and open source</h2>
		<p>
			MP Forge is free, and its code is open for anyone to read and change, under the{' '}
			<a href={places.licence}>GNU General Public License, version 3 or later</a>.
		</p>
		<p class="choices">
			<a class="button large" href={places.download}>Download</a>
			<a class="button quiet" href={places.source}>See the code</a>
		</p>
	</section>
</Website>
