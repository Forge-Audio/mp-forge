{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MP Forge",
  "version": "0.1.10",
  "identifier": "io.github.forge-audio.mp-forge",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MP Forge",
        "width": 1320,
        "height": 880,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "style-src": "'self' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' blob: https://raw.githubusercontent.com",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGRjlCQUMyQkFDOUE1MjkKUldRcHBjbTZ3cnI1TDIrUjN5SG9GcnVyYVZmaHZaYVBPUjI3R3VRVGY5OGswZHRuUWxrQjNFOG0K",
      "endpoints": ["https://github.com/Forge-Audio/mp-forge/releases/latest/download/latest.json"]
    }
  }
}
